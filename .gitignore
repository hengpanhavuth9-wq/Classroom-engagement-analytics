# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
.pytest_cache/

# Environment
.env
.env.local

# Next.js
frontend/.next/
frontend/node_modules/
frontend/out/

# Docker volumes
infra/pgdata/
infra/redis_data/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Model weights (downloaded, not vendored)
backend/models/**/*.onnx
backend/app/pipeline/weights/*.onnx
backend/app/pipeline/*.task

# Consented classroom recordings — offline validation only, never committed
backend/recordings/
backend/annotations/
backend/eval/out/
backend/eval/ratings/

# Local SQLite dev DB (see CLAUDE.md "zero-dependency local dev") — was
# previously committed as backend/reli_dev.db, a snapshot of a schema that
# has since changed; `create_all` can't alter an existing table, so a
# committed copy just meant a stale DB shadowing whatever schema the code
# actually expects on the next clone.
backend/*.db
backend/*.db-journal

# Python virtual envs made directly under backend/ (e.g. `python -m venv .venv`
# from within backend/), on top of the repo-root patterns above.
backend/.venv/
backend/venv/
