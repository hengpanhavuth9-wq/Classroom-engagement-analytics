# Copy to .env for local dev. Every value below is a Settings field in
# app/config.py — anything not listed here just uses that file's default.
# pydantic-settings rejects unrecognized keys, so don't add ones that
# aren't in Settings (this file used to ship EMOTION_SKIP_FRAMES, a field
# from the old emotion pipeline that no longer exists, which made the
# backend refuse to start).

# Zero-dependency local dev — no Postgres or Redis server needed:
DATABASE_URL=sqlite:///reli_dev.db
REDIS_URL=memory://

# A shared dev secret used two ways: (1) the WebSocket/REST bearer token
# (see app/api/security.py — set NEXT_PUBLIC_API_TOKEN to the same value on
# the frontend), and (2) FastAPI's own SECRET_KEY. Generate a real one with
# `openssl rand -hex 32` before this ever leaves your machine.
SECRET_KEY=dev-secret-key-replace-in-production

MAX_FACES_PER_CAMERA=40
METRIC_WRITE_INTERVAL=30
ALERT_THRESHOLD=50.0
ALERT_COOLDOWN=120
CORS_ORIGINS=["http://localhost:3000"]
